# Supabase credentials for optional --upsert-supabase mode.
# Prefer loading via Doppler: doppler run --project codingagents --config dev -- ...
# NEVER commit real keys. Use service_role for upsert only — not the anon key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# Optional: set temporarily to run verify_supabase_security.ps1 anon-denial test
# SUPABASE_ANON_KEY=your-anon-key
# Optional fallback when only the service key is in Doppler:
SUPABASE_PROJECT_REF=agookcvqnalxxcnhttmd
